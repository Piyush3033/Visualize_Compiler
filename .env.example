# ==========================================
# Advanced AST Visualizer - Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your values

# ==========================================
# Application Configuration
# ==========================================

# Environment: development, staging, production
NODE_ENV=development

# Port for development server
PORT=3000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Application Name
NEXT_PUBLIC_APP_NAME="Advanced AST Visualizer"

# Theme: dark, light, auto
NEXT_PUBLIC_THEME=dark

# ==========================================
# Compiler Configuration
# ==========================================

# Maximum code size for compilation (in bytes)
# Default: 100KB = 102400
MAX_CODE_SIZE=102400

# Maximum compilation timeout (in milliseconds)
# Default: 10 seconds = 10000
MAX_COMPILATION_TIME=10000

# Maximum AST depth to prevent stack overflow
# Default: 100
MAX_AST_DEPTH=100

# Maximum number of nodes in AST
# Default: 5000
MAX_AST_NODES=5000

# ==========================================
# Feature Flags
# ==========================================

# Enable syntax highlighting
NEXT_PUBLIC_ENABLE_SYNTAX_HIGHLIGHTING=true

# Enable code editor
NEXT_PUBLIC_ENABLE_EDITOR=true

# Enable AST visualization
NEXT_PUBLIC_ENABLE_VISUALIZATION=true

# Enable export functionality (SVG, JSON, etc.)
NEXT_PUBLIC_ENABLE_EXPORT=true

# Enable search/filter in visualizer
NEXT_PUBLIC_ENABLE_SEARCH=true

# Enable dark mode toggle
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=true

# ==========================================
# Analytics (Optional)
# ==========================================

# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# Sentry DSN for error tracking
SENTRY_DSN=

# ==========================================
# Supabase Configuration (Optional)
# ==========================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Third-party Services
# ==========================================

# GitHub OAuth App (Optional - for authentication)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Service (Optional - for notifications)
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ==========================================
# Development Tools
# ==========================================

# Enable debug logging
DEBUG=ast-visualizer:*

# Enable verbose output
VERBOSE=false

# ==========================================
# Security Configuration
# ==========================================

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limit: requests per hour per IP
RATE_LIMIT_REQUESTS=100

# API Key for private endpoints (if implemented)
API_KEY=your-secret-api-key-here

# JWT Secret for session tokens (if implemented)
JWT_SECRET=your-jwt-secret-here

# ==========================================
# Build Configuration
# ==========================================

# Skip type checking during build (useful for CI/CD)
SKIP_TYPE_CHECK=false

# Generate source maps for production (for debugging)
GENERATE_SOURCEMAPS=false

# ==========================================
# Notes
# ==========================================
# - Never commit .env.local to git (use .env.example instead)
# - All NEXT_PUBLIC_* variables are exposed to the browser
# - Server-side only variables should NOT have NEXT_PUBLIC_ prefix
# - For Vercel, set environment variables in the dashboard: Settings → Environment Variables
# - For Docker, pass env vars with -e flag: docker run -e KEY=value
